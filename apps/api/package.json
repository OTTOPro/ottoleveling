{
  "name": "ottoleveling-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "types": "wrangler types --include-runtime=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@jsr/negrel__webpush": "0.5.0",
    "hono": "^4.13.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4.20260524.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.0.0"
  }
}
