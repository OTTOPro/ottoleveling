# Copy to .env.local. .env.local is gitignored.

# API Worker base URL. In development it defaults to http://localhost:8787.
PUBLIC_API_BASE=http://localhost:8787

# Development only: must match DEV_TOKEN in apps/api/.dev.vars.
# Ignored by production builds, which authenticate with Cloudflare Access.
PUBLIC_DEV_TOKEN=localdevtoken

# Name shown in the Today header.
PUBLIC_PLAYER_NAME=Player
